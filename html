<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lydia &amp; Rueben — 27 December 2026</title>
<meta name="description" content="The roora of Lydia R. Fambarega and Rueben Chaibva. Sunday 27 December 2026, Bulawayo.">
<meta property="og:title" content="Lydia &amp; Rueben — 27 December 2026">
<meta property="og:description" content="You are invited to our roora in Bulawayo.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cormorant+Garamond:ital,wght@0,300;0,500;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F6F1E7; --paper-2:#EFE7DA; --ink:#332F3B; --ink-soft:#5D5763;
  --terra:#B87355; --terra-dark:#9C5B3F; --line:rgba(51,47,59,.22);
  --script:'Great Vibes',cursive; --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'Montserrat',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-weight:300;
     line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden}

.wrap{max-width:640px;margin:0 auto;padding:0 26px}
section{padding:76px 0;position:relative}
.eyebrow{font-size:.66rem;letter-spacing:.34em;text-transform:uppercase;color:var(--ink-soft);
         text-align:center;font-weight:400}
.script{font-family:var(--script);color:var(--terra-dark);line-height:1.15;font-weight:400}
.rule{width:78px;height:1px;background:var(--line);margin:22px auto}

/* ---------- the seal: tap to open ---------- */
#seal{position:fixed;inset:0;z-index:60;background:var(--paper-2);
      display:flex;flex-direction:column;align-items:center;justify-content:center;gap:30px;
      transition:opacity .9s ease,visibility .9s}
#seal.open{opacity:0;visibility:hidden}
.wax{width:132px;height:132px;border-radius:50%;border:0;cursor:pointer;
     background:radial-gradient(circle at 34% 30%,#C9825F,#9C5B3F 62%,#7E442D);
     color:#F6ECE2;font-family:var(--script);font-size:2.5rem;line-height:132px;
     box-shadow:0 10px 26px rgba(90,50,30,.34);transition:transform .35s ease}
.wax:hover,.wax:focus-visible{transform:scale(1.05)}
.wax:focus-visible{outline:2px solid var(--terra-dark);outline-offset:6px}
#seal p{font-size:.68rem;letter-spacing:.32em;text-transform:uppercase;color:var(--ink-soft)}

/* ---------- sticky header ---------- */
header{position:sticky;top:0;z-index:40;background:rgba(246,241,231,.93);
       backdrop-filter:blur(8px);border-bottom:1px solid var(--line);
       text-align:center;padding:11px 0;opacity:0;transition:opacity .5s}
header.show{opacity:1}
header .script{font-size:1.5rem}

/* ---------- hero ---------- */
.hero{padding:64px 0 40px;text-align:center;position:relative;overflow:hidden}
.hero .bloom{position:absolute;pointer-events:none;opacity:.92}
.bloom-a{top:-6px;left:-60px;width:124px}
.bloom-b{bottom:-6px;right:-54px;width:104px}
.hero-names{font-family:var(--script);color:var(--terra-dark);font-size:clamp(3rem,15vw,4.6rem);
            position:relative;z-index:2}
.amp{font-family:var(--script);font-size:1.9rem;color:var(--ink-soft);margin:2px 0}
.hero .eyebrow{margin-bottom:26px;position:relative;z-index:2;max-width:278px;margin-left:auto;margin-right:auto}
.hero-date{font-size:.74rem;letter-spacing:.28em;text-transform:uppercase;margin-top:26px;
           position:relative;z-index:2}

/* ---------- calendar strip, carried from the printed card ---------- */
.cal{margin:34px auto 0;max-width:430px;position:relative;z-index:2;
     background:linear-gradient(var(--paper),var(--paper));padding:6px 0}
.cal-month{font-size:.78rem;letter-spacing:.4em;text-align:center;margin-bottom:16px;font-weight:400}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);text-align:center;gap:2px}
.cal-grid span{font-family:var(--serif);font-style:italic;font-size:.82rem;color:var(--ink-soft)}
.cal-grid b{font-weight:400;font-size:1.12rem;padding:9px 0;position:relative}
.cal-grid b.on{color:var(--terra-dark);font-weight:500}
.cal-grid b.on::before{content:"";position:absolute;inset:-8px -3px -12px;
  background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-58 -46 116 118'><path d='M0,-14 C-16,-40 -52,-30 -52,-2 C-52,26 -20,44 0,64 C20,44 52,26 52,-2 C52,-30 16,-40 0,-14 Z' fill='none' stroke='%23B87355' stroke-width='3' stroke-dasharray='5 9' stroke-linecap='round'/></svg>") center/contain no-repeat}

/* ---------- countdown ---------- */
.count{background:var(--terra-dark);color:#F7EDE4;text-align:center}
.count .eyebrow{color:rgba(247,237,228,.72)}
.count-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:26px}
.count-grid div{padding:6px 0}
.count-grid strong{display:block;font-family:var(--serif);font-size:clamp(1.9rem,9vw,2.7rem);
                   font-weight:300;line-height:1}
.count-grid small{font-size:.56rem;letter-spacing:.22em;text-transform:uppercase;
                  color:rgba(247,237,228,.68)}

/* ---------- detail blocks ---------- */
.block{text-align:center}
.block h2{font-family:var(--script);font-weight:400;color:var(--terra-dark);
          font-size:2.6rem;margin-bottom:4px}
.block p{color:var(--ink-soft);font-size:.92rem}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:34px;margin-top:12px}
.pair h3{font-family:var(--script);font-weight:400;color:var(--terra-dark);font-size:1.9rem}
.pair p{font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;margin-top:8px}

.btn{display:inline-block;margin-top:24px;padding:13px 30px;border:1px solid var(--terra-dark);
     color:var(--terra-dark);text-decoration:none;font-size:.68rem;letter-spacing:.26em;
     text-transform:uppercase;transition:background .3s,color .3s}
.btn:hover,.btn:focus-visible{background:var(--terra-dark);color:var(--paper)}

/* ---------- programme ---------- */
.prog{border-top:1px solid var(--line)}
.prog li{list-style:none;border-bottom:1px solid var(--line);padding:22px 0;
         display:grid;grid-template-columns:44px 1fr;gap:16px;align-items:baseline}
.prog .n{font-family:var(--serif);font-size:1.5rem;color:var(--terra);font-weight:300}
.prog h4{font-size:.76rem;letter-spacing:.24em;text-transform:uppercase;font-weight:500}
.prog p{font-size:.88rem;color:var(--ink-soft);margin-top:5px}

/* ---------- rsvp ---------- */
.rsvp{background:var(--paper-2)}
form{margin-top:30px;display:grid;gap:17px}
label{display:block;font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;
      color:var(--ink-soft);margin-bottom:7px}
input,select,textarea{width:100%;padding:12px 13px;font-family:var(--sans);font-size:.94rem;
  font-weight:300;color:var(--ink);background:var(--paper);border:1px solid var(--line);
  border-radius:0;-webkit-appearance:none;appearance:none}
input:focus,select:focus,textarea:focus{outline:2px solid var(--terra);outline-offset:1px}
textarea{min-height:104px;resize:vertical}
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.choice{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.choice input{position:absolute;opacity:0;width:0}
.choice span{display:flex;align-items:center;justify-content:center;min-height:48px;text-align:center;padding:8px 6px;border:1px solid var(--line);
  font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;background:var(--paper)}
.choice input:checked + span{background:var(--terra-dark);color:var(--paper);border-color:var(--terra-dark)}
.choice input:focus-visible + span{outline:2px solid var(--terra);outline-offset:2px}
button[type=submit]{padding:16px;background:var(--terra-dark);color:var(--paper);border:0;
  font-family:var(--sans);font-size:.68rem;letter-spacing:.28em;text-transform:uppercase;cursor:pointer}
button[type=submit]:hover{background:var(--terra)}

footer{text-align:center;padding:64px 0 72px}
footer .script{font-size:2.4rem}
footer p{font-size:.66rem;letter-spacing:.24em;text-transform:uppercase;color:var(--ink-soft);margin-top:14px}

.reveal{opacity:0;transform:translateY(20px);transition:opacity .8s ease,transform .8s ease}
.reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .reveal{opacity:1;transform:none;transition:none}
  html{scroll-behavior:auto}
  #seal{transition:none}
}
@media (max-width:340px){ .pair{grid-template-columns:1fr;gap:26px} }
</style>
</head>
<body>

<!-- tap the seal to open -->
<div id="seal">
  <button class="wax" id="waxBtn" aria-label="Open the invitation">L&amp;R</button>
  <p>Tap to open</p>
</div>

<header id="bar"><div class="script">Lydia &amp; Rueben</div></header>

<main>

<section class="hero">
  <img class="bloom bloom-a" src="images/rose-white-cluster.png" alt="" aria-hidden="true">
  <img class="bloom bloom-b" src="images/rose-crimson-single.png" alt="" aria-hidden="true">
  <div class="wrap">
    <p class="eyebrow">The Chaibva and Fambarega families<br>request the pleasure of your company at the roora of</p>
    <h1 class="hero-names">Lydia R. Fambarega</h1>
    <div class="amp">&amp;</div>
    <div class="hero-names">Rueben Chaibva</div>

    <div class="cal">
      <div class="cal-month">DECEMBER</div>
      <div class="cal-grid">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        <b>21</b><b>22</b><b>23</b><b>24</b><b>25</b><b>26</b><b class="on">27</b>
      </div>
    </div>
    <p class="hero-date">Sunday, 27 December 2026 &nbsp;·&nbsp; 12:30</p>
  </div>
</section>

<section class="count">
  <div class="wrap">
    <p class="eyebrow">Counting down to the day</p>
    <div class="count-grid" id="clock">
      <div><strong id="d">—</strong><small>Days</small></div>
      <div><strong id="h">—</strong><small>Hours</small></div>
      <div><strong id="m">—</strong><small>Minutes</small></div>
      <div><strong id="s">—</strong><small>Seconds</small></div>
    </div>
  </div>
</section>

<section class="reveal">
  <div class="wrap block">
    <p class="eyebrow">Where and when</p>
    <div class="rule"></div>
    <div class="pair">
      <div><h3>Time</h3><p>12:30 Midday</p></div>
      <div><h3>Dress Code</h3><p>Traditional Attire</p></div>
    </div>
    <div class="rule"></div>
    <h2>Venue</h2>
    <p>Waterford<br>11 Jessica Mary<br>Bulawayo, Zimbabwe</p>
    <a class="btn" href="https://www.google.com/maps/search/?api=1&amp;query=Waterford%2C%2011%20Jessica%20Mary%2C%20Bulawayo%2C%20Zimbabwe" target="_blank" rel="noopener">Open in Maps</a>
  </div>
</section>

<section class="reveal">
  <div class="wrap">
    <p class="eyebrow">The order of the day</p>
    <div class="rule"></div>
    <ul class="prog">
      <li><span class="n">01</span><div><h4>Arrival</h4><p>Guests are seated. Replace this with your own wording.</p></div></li>
      <li><span class="n">02</span><div><h4>The families meet</h4><p>Replace this with your own wording.</p></div></li>
      <li><span class="n">03</span><div><h4>Roora</h4><p>Replace this with your own wording.</p></div></li>
      <li><span class="n">04</span><div><h4>Celebration</h4><p>Replace this with your own wording.</p></div></li>
    </ul>
  </div>
</section>

<section class="rsvp reveal" id="rsvp">
  <div class="wrap">
    <p class="eyebrow">Kindly reply by 31 October 2026</p>
    <div class="rule"></div>
    <h2 style="font-family:var(--script);font-weight:400;color:var(--terra-dark);font-size:2.6rem;text-align:center">Confirm your attendance</h2>

    <form name="rsvp" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="rsvp">
      <p style="display:none"><label>Leave blank <input name="bot-field"></label></p>

      <div><label for="name">Full name</label>
        <input id="name" name="name" type="text" required autocomplete="name"></div>

      <div class="two">
        <div><label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email"></div>
        <div><label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel"></div>
      </div>

      <div><label>Will you attend?</label>
        <div class="choice">
          <label style="margin:0"><input type="radio" name="attending" value="Joyfully accepts" required><span>Joyfully accepts</span></label>
          <label style="margin:0"><input type="radio" name="attending" value="Regretfully declines"><span>Regretfully declines</span></label>
        </div>
      </div>

      <div class="two">
        <div><label for="guests">Number of guests</label>
          <input id="guests" name="guests" type="number" min="1" max="10" value="1"></div>
        <div><label for="diet">Dietary needs</label>
          <select id="diet" name="diet">
            <option>None</option><option>Vegetarian</option><option>Halaal</option>
            <option>No pork</option><option>Other (noted below)</option>
          </select></div>
      </div>

      <div><label for="msg">Message to the couple</label>
        <textarea id="msg" name="message"></textarea></div>

      <button type="submit">Send confirmation</button>
    </form>

    <p style="text-align:center;margin-top:22px;font-size:.78rem;color:var(--ink-soft)">
      Or reach Vanessa on <a href="tel:+27730389502" style="color:var(--terra-dark)">+27 73 038 9502</a>
    </p>
  </div>
</section>

</main>

<footer>
  <div class="wrap">
    <div class="script" style="color:var(--terra-dark)">Lydia &amp; Rueben</div>
    <p>Chaibva &nbsp;·&nbsp; Fambarega</p>
    <p style="margin-top:20px">We give thanks</p>
  </div>
</footer>

<script>
// seal
var seal=document.getElementById('seal'), bar=document.getElementById('bar');
document.getElementById('waxBtn').addEventListener('click',function(){
  seal.classList.add('open');
  setTimeout(function(){seal.remove()},1000);
});

// header appears once past the hero
addEventListener('scroll',function(){
  bar.classList.toggle('show', scrollY>420);
},{passive:true});

// countdown — 27 December 2026, 12:30, Zimbabwe time (UTC+2)
var target=new Date('2026-12-27T12:30:00+02:00').getTime();
function pad(n){return n<10?'0'+n:''+n}
function tick(){
  var t=target-Date.now();
  if(t<0){document.getElementById('clock').innerHTML=
    '<div style="grid-column:1/-1"><strong>Today</strong><small>We are married</small></div>';return}
  var d=Math.floor(t/864e5),h=Math.floor(t/36e5)%24,m=Math.floor(t/6e4)%60,s=Math.floor(t/1e3)%60;
  document.getElementById('d').textContent=d;
  document.getElementById('h').textContent=pad(h);
  document.getElementById('m').textContent=pad(m);
  document.getElementById('s').textContent=pad(s);
}
tick(); setInterval(tick,1000);

// scroll reveals
var io=new IntersectionObserver(function(es){
  es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})
},{threshold:.12});
document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)});
</script>
</body>
</html>